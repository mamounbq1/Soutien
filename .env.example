# Configuration de l'application
# Copier ce fichier en .env et modifier les valeurs selon vos besoins

# Base de données
DB_PATH=database/app.db
DB_BACKUP_DIR=database/backups
DB_AUTO_BACKUP=true

# Application
APP_NAME=Système de Gestion - Centre de Soutien Scolaire
APP_VERSION=2.0
DEBUG_MODE=false

# Interface
THEME_MODE=light
WINDOW_WIDTH=1400
WINDOW_HEIGHT=800

# Logs
LOG_ENABLED=true
LOG_FILE=app.log
LOG_LEVEL=INFO

# Paiements
CURRENCY_SYMBOL=DH
DEFAULT_MONTHLY_FEE=500

# Horaires
SCHOOL_OPENING_HOUR=8
SCHOOL_CLOSING_HOUR=22
SESSION_DURATION_MINUTES=120
